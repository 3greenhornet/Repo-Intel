# ============================================================
# GITHUB
# ============================================================
GITHUB_TOKEN=<YOUR_GITHUB_TOKEN>
GITHUB_API_URL=https://api.github.com

# ============================================================
# STORAGE BACKENDS
#   Embedded (zero infra, 2026 default): GRAPH_STORE=sqlite (Recursive CTEs),
#   RELATIONAL_STORE=sqlite, CACHE_BACKEND=memory, VECTOR_STORE=numpy
#   Production: switch each to neo4j / postgres / redis / faiss|pinecone
# ============================================================
GRAPH_STORE=sqlite
RELATIONAL_STORE=sqlite
CACHE_BACKEND=memory
VECTOR_STORE=numpy

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<YOUR_NEO4J_PASSWORD>

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=repointel
POSTGRES_USER=repointel
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# (MongoDB removed — FIX-006d: no code consumed it)

FAISS_INDEX_PATH=            # empty = <project>/data/faiss
PINECONE_API_KEY=<YOUR_PINECONE_API_KEY>
PINECONE_ENV=<YOUR_PINECONE_ENV>

# ============================================================
# LLM (§10.1 — 2026 Resilient Multi-Provider Fallback Cascade)
#   litellm   : Multi-provider fallback chain (Groq -> Gemini -> OpenRouter -> Mistral)
#   openai    : OpenAI / Groq direct
#   anthropic : Anthropic Claude
#   zai       : local bridge to the z-ai CLI
# ============================================================
LLM_PROVIDER=litellm
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1200
USE_LLM_SUFFICIENCY=1

# Multi-Provider Reliability API Keys (At least one required for LiteLLM cascade)
GROQ_API_KEY=<YOUR_GROQ_API_KEY>
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
OPENROUTER_API_KEY=<YOUR_OPENROUTER_API_KEY>
MISTRAL_API_KEY=<YOUR_MISTRAL_API_KEY>
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>

# ============================================================
# EMBEDDINGS / MODELS (2026 CPU-Friendly Standards)
# ============================================================
EMBEDDING_MODEL_CODE=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_DOC=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
NLI_MODEL=dleemiller/EttinX-nli-xs
SEMGREP_OFFLINE=1

# ============================================================
# STATIC ANALYSIS (§4.2.3) — off by default; built-in analyzer runs
# ============================================================
ENABLE_SONAR=0
SONAR_URL=http://localhost:9000
SONAR_TOKEN=<YOUR_SONAR_TOKEN>
ENABLE_CODEQL=0
CODEQL_PATH=codeql

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=repointel

# ============================================================
# AGENTIC BUDGETS (§8.4.2)
# ============================================================
MAX_ITERATIONS=5
MAX_TOTAL_TOKENS=10000
MAX_TIME_SECONDS=60
MIN_EVIDENCE_COUNT=3

# ============================================================
# LOGGING / PERFORMANCE
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
MAX_WORKERS=4
BATCH_SIZE=100
CACHE_TTL=3600

# ============================================================
# SECURITY (§24)
# ============================================================
JWT_SECRET=<YOUR_JWT_SECRET>
API_KEY_SALT=<YOUR_API_KEY_SALT>
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL=2.0

# ============================================================
# PROMPT INJECTION LIMITS (§23.9)
# ============================================================
MAX_QUERY_LENGTH=1000
MAX_CONTEXT_LENGTH=50000

# --- Added by the fix worklist -------------------------------------------
# Python 3.12+ required (see pyproject.toml); 3.13 recommended.
# When REQUIRE_AUTH=1, mutating + query endpoints require a Bearer JWT
# issued by POST /api/v1/auth/token. Health, metrics and the dashboard
# remain public. Default 0 (dev mode).                (FIX-030)
REQUIRE_AUTH=0
# HMAC secret for GitHub push webhooks.               (FIX-036)
GITHUB_WEBHOOK_SECRET=
# Maximum parallel z-ai subprocesses. Higher values increase throughput
# at the cost of CPU; z-ai rate-limits aggressive parallelism. (FIX-016/039)
ZAI_MAX_CONCURRENT=4
# LLM-based sufficiency check (slower, more accurate). 0 = heuristic. (FIX-037)
USE_LLM_SUFFICIENCY=0
# Memory budget (MB) for adaptive FAISS index selection. (FIX-026)
VECTOR_MEMORY_BUDGET_MB=4096
